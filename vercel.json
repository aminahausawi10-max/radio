{
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.6.2"
        }
    },
    "rewrites": [
        { "source": "/tiktokT74SEOJJBvWy0DHDNZcrzIHW1HVLFQaq(.*)", "destination": "/api/index.php?route=tiktok_verify" },
        { "source": "/tiktok-developers-site-verification(.*)", "destination": "/api/index.php?route=tiktok_verify" },
        { "source": "/tiktok(.*)verification(.*)", "destination": "/api/index.php?route=tiktok_verify" },
        { "source": "/uploads/(.*)", "destination": "/api/index.php?route=uploads&file=$1" },
        { "source": "/api/(.*)", "destination": "/api/index.php?route=$1" },
        { "source": "/api", "destination": "/api/index.php" },
        { "source": "/admin", "destination": "/admin.html" },
        { "source": "/news", "destination": "/news.html" },
        { "source": "/terms", "destination": "/terms.html" },
        { "source": "/privacy", "destination": "/privacy.html" }
    ]
}
